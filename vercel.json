{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/jobs?slot=summer",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/jobs?slot=winter",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "backups": false
    }
  }
}
